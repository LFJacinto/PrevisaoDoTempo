.title {
    font-size: 24px;
    -unity-font-style: bold;
    margin-bottom: 10px;
    color: rgb(21, 67, 96);
}

.temp {
    font-size: 40px;
    -unity-font-style: bold;
    color: rgb(230, 126, 34);
}

.app-button {
    background-color: rgb(52, 152, 219);
    color: rgb(255, 255, 255);
    border-radius: 6px;
    border-width: 0;
    -unity-font-style: bold;
}

.app-button:hover {
    background-color: rgb(41, 128, 185);
}